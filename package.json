{
  "name": "batch-metadata-editor",
  "productName": "Batch Metadata Editor",
  "version": "1.2.0",
  "description": "Drop up to 20 files, type the metadata, get edited copies.",
  "main": "src/main.js",
  "author": "RC-SOLAX",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "playwright test test/e2e.spec.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "exiftool-vendored": "^39.0.1",
    "jszip": "^3.10.2",
    "node-id3": "^0.2.9",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rcsolax.batchmetadataeditor",
    "productName": "Batch Metadata Editor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/exiftool-vendored*/**"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Batch Metadata Editor",
      "artifactName": "Batch-Metadata-Editor-Setup-${version}.${ext}"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RC-SOLAX/batch-metadata-editor.git"
  }
}
